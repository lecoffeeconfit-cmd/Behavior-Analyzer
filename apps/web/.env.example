# Free analysis needs NONE of these. Configure on Netlify only for optional Pro.
WEB_ORIGIN=https://your-site.netlify.app
CHROME_EXTENSION_IDS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
DATABASE_URL=
DATABASE_SSL=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TRANSCRIPTION_MODEL=
PRO_PRICE_CENTS=299
PRO_MONTHLY_CREDITS=60
PRO_REQUEST_CREDITS=1
PRO_MAX_REQUEST_COST_CENTS=5
PRO_MAX_MONTHLY_COST_CENTS=100
PRO_GLOBAL_MONTHLY_COST_CENTS=10000
AI_MAX_OUTPUT_TOKENS=800
# Set conservative upper prices matching YOUR chosen provider/model.
AI_INPUT_CENTS_PER_MILLION_TOKENS=100
AI_OUTPUT_CENTS_PER_MILLION_TOKENS=400
AI_IMAGE_TOKEN_UPPER_BOUND=6000
AI_TRANSCRIPTION_CENTS_PER_MINUTE=10
# Separate implementation phase: disabled by default, accepts test keys only.
BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Only for the preserved /legacy self-hosted Python workflow. Disabled on Netlify.
ENABLE_LEGACY_WORKER=false
