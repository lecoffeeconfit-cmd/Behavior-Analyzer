{
  "name": "behavior-analyzer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:web",
    "build": "npm run build:web",
    "dev:web": "npm run assets && npm run worker:web && npm run dev -w @video-analyzer/web",
    "dev:extension": "node scripts/build.mjs --watch",
    "build:web": "npm run assets && npm run worker:web && npm run build -w @video-analyzer/web",
    "build:extension": "npm run assets && node scripts/build.mjs",
    "worker:web": "node scripts/build-web-worker.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "start": "npm run start -w @video-analyzer/web",
    "typecheck": "tsc --noEmit -p apps/extension/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "lint": "eslint apps packages scripts tests",
    "package:extension": "npm run build:extension && node scripts/package.mjs",
    "check": "npm run typecheck && npm test && npm run lint && npm run build:web && npm run build:extension"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
